	file = {PDF:C\:\\Users\\Sunny\\Zotero\\storage\\99PYDZGE\\Booth et al. - 2024 - BLN600 A Parallel Corpus of MachineHuman Transcribed Nineteenth Century Newspaper Texts.pdf:application/pdf},
